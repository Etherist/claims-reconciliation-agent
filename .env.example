# Configuration for Claims Reconciliation Agent

# File Processing
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=csv,json,edi

# Fuzzy Matching Thresholds
FUZZY_NAME_THRESHOLD=90  # 0-100, minimum similarity for patient names
DATE_TOLERANCE_DAYS=2    # Maximum days difference for date matching
AMOUNT_TOLERANCE_PCT=0.01  # 1% tolerance for amount matching
AMOUNT_TOLERANCE_ABS=10.0  # Absolute tolerance for amounts

# Logging
LOG_LEVEL=INFO
LOG_FILE=reconciliation.log
LOG_SANITIZE_PII=false  # Set to true to redact patient names/amounts from logs

# Report Generation
REPORT_DIR=reports
DEFAULT_REPORT_FORMAT=csv  # csv or pdf

# Australian Healthcare Insurers (demo)
SUPPORTED_INSURERS=Medicare,Bupa,Medibank,HBF, nib

# API Keys (for stretch integrations - not used in demo)
# MEDICARE_API_KEY=
# BUPA_API_KEY=
